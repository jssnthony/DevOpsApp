extends layout

block content
  .site-title
    h1= title 
  .site-description 
    p Welcome to #{title}

  a(href="/projectsInsert") Agregar Nuevo Proyecto

  table
    thead
      tr
        th ID
        th Nombre
        th Descripción
        th Repositorio
        th Acciones
        th Tareas
    tbody
      each project in projects
        tr
          td= project.id.slice(-12)
          td.title-column= project.title 
          td.description-column= project.description
          td= project.repository
          td
            a(href=`/projectsUpdate/${project.id}`) Editar
            form(action="/projectsArchive/" + project.id, method="post", style="display:inline")
            button(type="submit") Archivar
            form(action="/projectsDisable/" + project.id, method="post", style="display:inline")
            button(type="submit") Desactivar
          td
            a(href=`/projectsTasks/${project.id}`) Ver Tareas
