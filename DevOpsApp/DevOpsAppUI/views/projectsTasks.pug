extends layout

block content
  h1 Tareas del Proyecto #{projectId}

  a(href=`/projects/${projectId}/tasks/new`) Agregar Nueva Tarea

  if tasks.length
    table
      thead
        tr
          th Título
          th Descripción
          th Estado
      tbody
        each task in tasks
          tr
            td= task.title
            td= task.description
            td= task.status
  else
    p No hay tareas registradas aún.
