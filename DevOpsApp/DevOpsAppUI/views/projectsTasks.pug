extends layout

block content

  h1 Tareas del Proyecto #{projectId}

  a(href=`/projectsTasksInsert/${projectId}`) Agregar Nueva Tarea

  if tasks.length
    table
      thead
        tr
          th ID
          th Título
          th Descripción
          th Estado
      tbody
        each task in tasks
          tr
            td= task.id
            td= task.title
            td= task.description
            td
              button(
                class="task-status",
                data-task-id=task.id,
                onclick="alterStatus(this)"
              )= task.isDone ? 'Done' : 'ToDo'
                
  else
    p No hay tareas registradas aún.
