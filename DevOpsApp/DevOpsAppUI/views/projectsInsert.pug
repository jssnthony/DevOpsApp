extends layout

block content
  h1= title
  form(action="/projectsInsert" method="POST")
    div
      label(for="title") Nombre:
      input(type="text" name="title" required)
    div
      label(for="description") Descripción:
      textarea(name="description" required)
    div
      label(for="repository") Repositorio:
      input(type="text" name="repository" required)
    div
      button(type="submit") Insertar Proyecto
