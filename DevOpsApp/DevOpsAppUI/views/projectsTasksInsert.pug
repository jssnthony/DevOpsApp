extends layout

block content
  h1 Agregar Tarea al Proyecto

  form(action='/projectsTasksInsert/' + projectId , method='post')
    div
      label(for='title') Título:
      input(type='text', name='title', id='title', required)

    div
      label(for='description') Descripción:
      textarea(name='description', id='description', required)

    div
      button(type='submit') Agregar Tarea

    br
    a(href='/projectsTasks/' + projectId ) ? Volver a la lista de tareas
