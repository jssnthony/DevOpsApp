extends layout

block content
    h1= title
    form(action='/projectsTasksUpdate/' + task.taskId, method='POST')
        div
            label(for='name') Nombre:
            input(type='text', name='title', value=task.title, required)
        div
            label(for='description') Descripción:
            textarea(name='description', required)= task.description
        div
            button(type='submit') Guardar cambios