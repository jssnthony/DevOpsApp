extends layout

block content
    h1= title
    form(action='/projectsUpdate/' + project.id, method='POST')
        div
            label(for='name') Nombre:
            input(type='text', name='title', value=project.title, required)
        div
            label(for='description') Descripción:
            textarea(name='description', required)= project.description
        div
            label(for='repository') Repositorio:
            input(type='text', name='repository', value=project.repository, required)
        div
            button(type='submit') Guardar cambios